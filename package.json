{
  "name": "sakuttodraw",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "description": "SakuttoDraw - Quick Screenshot Annotator PWA powered by Excalidraw",
  "type": "module",
  "scripts": {
    "sync-assets": "node scripts/sync-excalidraw-assets.mjs",
    "predev": "npm run sync-assets",
    "dev": "vite",
    "prebuild": "npm run sync-assets",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "biome check src scripts vite.config.ts",
    "verify-dist": "node scripts/verify-dist.mjs",
    "preview": "vite preview",
    "pretest": "npm run sync-assets",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.0-dabd83c",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.1.2",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "nanoid@3.3.3": "^3.3.20"
  }
}
