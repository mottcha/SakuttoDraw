{
  "name": "sakuttodraw",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "description": "SakuttoDraw - Quick Screenshot Annotator PWA powered by Excalidraw",
  "type": "module",
  "scripts": {
    "sync-assets": "node scripts/sync-excalidraw-assets.mjs",
    "predev": "npm run sync-assets",
    "dev": "vite",
    "prebuild": "npm run sync-assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "npm run sync-assets",
    "test": "vitest run"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.0-2c3dcc0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "nanoid@3.3.3": "^3.3.20"
  }
}
